    arch = "aarch64",
    version = "11.1",
)
use_repo(netbsd, "curl_ca_bundle", "netbsd_11_1_aarch64", "netbsd_11_1_aarch64_tools", "netbsd_11_1_amd64", "netbsd_11_1_amd64_tools")
