use_repo(go_deps, "com_github_aws_aws_sdk_go_v2", "com_github_aws_aws_sdk_go_v2_config", "com_github_aws_aws_sdk_go_v2_service_cloudwatchlogs", "com_github_aws_aws_sdk_go_v2_service_ebs", "com_github_aws_aws_sdk_go_v2_service_ec2", "com_github_aws_aws_sdk_go_v2_service_iam", "com_github_aws_aws_sdk_go_v2_service_sts", "com_github_aws_aws_sdk_go_v2_service_xray", "com_github_open_telemetry_opentelemetry_collector_contrib_exporter_awscloudwatchlogsexporter", "com_github_open_telemetry_opentelemetry_collector_contrib_exporter_awsemfexporter", "com_github_open_telemetry_opentelemetry_collector_contrib_exporter_awsxrayexporter", "com_github_open_telemetry_opentelemetry_collector_contrib_exporter_azuremonitorexporter", "com_github_open_telemetry_opentelemetry_collector_contrib_exporter_googlecloudexporter", "com_github_open_telemetry_opentelemetry_collector_contrib_processor_resourceprocessor", "com_github_open_telemetry_opentelemetry_collector_contrib_receiver_hostmetricsreceiver", "io_opentelemetry_go_collector_component", "io_opentelemetry_go_collector_confmap", "io_opentelemetry_go_collector_confmap_provider_envprovider", "io_opentelemetry_go_collector_confmap_provider_fileprovider", "io_opentelemetry_go_collector_confmap_provider_yamlprovider", "io_opentelemetry_go_collector_exporter", "io_opentelemetry_go_collector_exporter_debugexporter", "io_opentelemetry_go_collector_exporter_otlpexporter", "io_opentelemetry_go_collector_exporter_otlphttpexporter", "io_opentelemetry_go_collector_otelcol", "io_opentelemetry_go_collector_processor", "io_opentelemetry_go_collector_processor_batchprocessor", "io_opentelemetry_go_collector_processor_memorylimiterprocessor", "io_opentelemetry_go_collector_receiver", "io_opentelemetry_go_collector_receiver_otlpreceiver", "io_opentelemetry_go_collector_service", "io_opentelemetry_go_otel", "io_opentelemetry_go_otel_exporters_otlp_otlplog_otlploghttp", "io_opentelemetry_go_otel_exporters_otlp_otlpmetric_otlpmetrichttp", "io_opentelemetry_