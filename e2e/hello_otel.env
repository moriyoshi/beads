# Instance user-data for //e2e:hello_custom_otel_image. With otel
# user_data_env, init passes these to the collector as well as the program.
HELLO_RESOURCE_KEY=deployment.environment.name
# Reserved for init's BEADS_* variables, so not passed to the collector.
BEADS_OTLP_ENDPOINT=http://192.0.2.1:4318
