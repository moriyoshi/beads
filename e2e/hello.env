# Instance user-data for //e2e:hello_image's boot and smoke tests. Init reads
# KEY=VALUE lines as program environment variables, overriding the image's
# env: this greeting replaces the BUILD file's "hello".
HELLO_GREETING=howdy

# A setting for init, not a variable for the program: an extra local address
# on lo0, as for an AWS overlay IP. Init passes the result to the program.
APPLIANCE_LOCAL_ADDRS=192.168.255.1/32

# Reserved for init, so ignored with a console warning.
OTEL_SERVICE_NAME=not-hello
